# Set these locally; do not commit actual identifiers.
BRIDGE_SOURCE_CHAT_ID=replace-with-your-source-chat
BRIDGE_TARGET_THREAD_ID=replace-with-your-fixed-target
BRIDGE_STATE_DIR=.bridge-state
# Optional trusted local adapter module. No default desktop credentials or pipes.
BRIDGE_ADAPTER_MODULE=
# Demo is opt-in and cannot execute desktop tasks.
BRIDGE_DEMO=false
